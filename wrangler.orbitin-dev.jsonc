{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orbitin-dev",
  "main": "./workers/frontend/index.ts",
  "compatibility_date": "2026-09-03",

  "observability": { "enabled": true },

  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "triggers": { "crons": [] },

  "r2_buckets": [
    {
      "binding": "CATALOGUE_BUCKET",
      "bucket_name": "orbitin-catalogue",
      "preview_bucket_name": "orbitin-catalogue-preview"
    }
  ],

  "analytics_engine_datasets": [
    { "binding": "USAGE_EVENTS", "dataset": "orbitin_dev_events" }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/catalog/*", "/events/*"]
  },

  "previews": {
      "r2_buckets": [
        {
          "binding": "CATALOGUE_BUCKET",
          "bucket_name": "orbitin-catalogue"
        }
      ]
   }
}
